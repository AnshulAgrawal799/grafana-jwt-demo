# Docker Compose settings for the local Grafana JWT demo.
# Copy this file to .env before changing values for your machine.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

ALLOWED_ORIGINS=http://localhost:8080
AUTHORIZED_EMAIL_DOMAINS=wheelocity.local,demo.local,test.com
MAX_TOKEN_TTL_MINUTES=60
GRAFANA_URL=http://localhost:3000
GRAFANA_JWT_KEY_ID=wow-web-prod-20260531124246
GRAFANA_JWT_ISSUER=wow-web
GRAFANA_JWT_AUDIENCE=grafana-insights
GRAFANA_JWT_ROLE=Viewer
GRAFANA_JWT_DEFAULT_TTL_SECONDS=900